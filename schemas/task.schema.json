{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noosphere task proposal v0.1",
  "description": "Proposition de contrat, non executable seule. Les autorisations, chemins et references doivent etre verifies hors schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "project", "baseRef", "objective", "role", "contextPaths", "allowedPaths", "deniedPaths", "dependencies", "acceptance", "checks", "limits", "delivery"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "baseRef": {"type": "string", "minLength": 1, "maxLength": 2000},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "role": {"enum": ["executor_fast", "reviewer"]},
    "contextPaths": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}, "uniqueItems": true, "maxItems": 64},
    "allowedPaths": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}, "uniqueItems": true, "maxItems": 64, "minItems": 1},
    "deniedPaths": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}, "uniqueItems": true, "maxItems": 64},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}, "uniqueItems": true, "maxItems": 64},
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}, "uniqueItems": true, "maxItems": 64, "minItems": 1},
    "checks": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}, "uniqueItems": true, "minItems": 1, "maxItems": 32},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeoutSeconds", "maxAttempts"],
      "properties": {
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["independentReview", "humanApproval", "autoMerge"],
      "properties": {
        "independentReview": {"const": true},
        "humanApproval": {"const": true},
        "autoMerge": {"const": false}
      }
    }
  }
}
